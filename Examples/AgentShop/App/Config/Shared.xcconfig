// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = AgentShop
PRODUCT_DISPLAY_NAME = AgentShop
PRODUCT_BUNDLE_IDENTIFIER = dev.olbartek.AgentShop
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.0

// (1 == iPhone, 2 == iPad). AgentShop is iPhone only.
TARGETED_DEVICE_FAMILY = 1

// ==========================================
// Swift
// ==========================================
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait

