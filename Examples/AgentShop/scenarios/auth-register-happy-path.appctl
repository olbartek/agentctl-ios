# A new account verifies its email, then signs in (spec §5.4, Figma "Signup" → "Verify Email").
register
name Carol Smith
email carol@example.com
password Secret123
confirm Secret123
terms on
submit
expect screen=auth/register/verify email=carol@example.com resendIn=30 canVerify=false call=auth.register
code 123456
expect canVerify=true
verify
expect screen=home/orders orders=0 call=auth.verifyEmail call=session.save
tab profile
expect name="Carol Smith" email=carol@example.com
